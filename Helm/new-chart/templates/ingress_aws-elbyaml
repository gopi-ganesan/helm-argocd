apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ .Values.ingress.name }}
  namespace: {{ .Release.Namespace }}
  annotations:
    kubernetes.io/ingress.class: {{ .Values.ingress.ingressClassName }}
    {{- toYaml .Values.ingress.annotations | nindent 4 }}

spec:
  ingressClassName: {{ .Values.ingress.ingressClassName }}
  rules:
    - http:
        paths:
          - path: /backend
            pathType: Prefix
            backend:
              service:
                name: {{ .Values.backend.serviceName }}  
                port:
                  number: {{ .Values.backend.port }}

          - path: /argocd
            pathType: Prefix
            backend:
              service:
                name: {{ .Values.ArgoCD.serviceName }}   
                port:
                  number: {{ .Values.ArgoCD.port }}

          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ .Values.frontend.serviceName }}  
                port:
                  number: {{ .Values.frontend.port }}

          - path: /grafana
            pathType: Prefix
            backend:
              service:
                name: {{ .Values.grafana.serviceName }}  
                port:
                  number: {{ .Values.grafana.port }}